# Copy to .env.local and fill in. Never commit .env.local — .gitignore covers .env*.
#
# Every variable here is server-only. Do NOT add a NEXT_PUBLIC_ prefix to any of
# them: that would inline the value into the browser bundle.
#
# Verify SMTP without a deploy:
#   node --env-file=.env.local scripts/check-smtp.mjs
#   node --env-file=.env.local scripts/check-smtp.mjs --send

# --- Contact form (IONOS mailbox) ---
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
# "true" only for implicit TLS on port 465; port 587 uses STARTTLS.
SMTP_SECURE=false
SMTP_USER=contact@example.com
SMTP_PASS=
# Where contact submissions are delivered. Defaults to SMTP_USER if unset.
MAIL_TO=contact@example.com

# --- Database (added in Phase 7) ---
# Injected automatically by the Vercel–Neon integration.
# DATABASE_URL=

# --- Auth (added in Phase 8) ---
# AUTH_SECRET=            # openssl rand -base64 32 — rotating this kills all sessions
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# ADMIN_GITHUB_ID=        # numeric GitHub user id, not the login
# AUTH_URL=https://www.ekeleogbadu.io
# AUTH_TRUST_HOST=true
