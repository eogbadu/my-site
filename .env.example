# Copy to .env.local and fill in. Never commit .env.local — .gitignore covers .env*.
#
# Every variable here is server-only. Do NOT add a NEXT_PUBLIC_ prefix to any of
# them: that would inline the value into the browser bundle.
#
# Verify SMTP without a deploy:
#   node --env-file=.env.local scripts/check-smtp.mjs
#   node --env-file=.env.local scripts/check-smtp.mjs --send

# --- Contact form (IONOS mailbox) ---
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
# "true" only for implicit TLS on port 465; port 587 uses STARTTLS.
SMTP_SECURE=false
SMTP_USER=contact@example.com
SMTP_PASS=
# Where contact submissions are delivered. Defaults to SMTP_USER if unset.
MAIL_TO=contact@example.com

# --- Database ---
# Injected automatically by the Vercel–Neon integration; pull locally with
#   vercel env pull .env.local
# Migrations are applied manually and never during `next build`:
#   DATABASE_URL='<url>' npm run db:migrate
DATABASE_URL=

# --- Auth ---
# Requires TWO GitHub OAuth apps (one callback URL each): prod and localhost.
# See docs/RUNBOOK.md H4/H5.
AUTH_SECRET=            # openssl rand -base64 32 — rotating this kills every session
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_GITHUB_ID=70936452  # numeric GitHub user id, never the login
AUTH_URL=http://localhost:3000   # https://www.ekeleogbadu.io in production (note the www)
# Required, or Auth.js rejects every request with UntrustedHost.
AUTH_TRUST_HOST=true
